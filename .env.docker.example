# =============================================================================
# SENTRAVAUX - Configuration Docker (production CentOS 7)
# Copier vers .env sur le serveur : cp .env.docker.example .env
# =============================================================================

APP_NAME=SENTRAVAUX
APP_ENV=production
# Obligatoire en production (copier depuis Laragon ou : php artisan key:generate --show)
APP_KEY=base64:REMPLACER_PAR_UNE_CLE
APP_DEBUG=false
# IP ou nom réellement accessible par les utilisateurs (sans placeholder)
APP_URL=http://10.101.3.217:8093

# Ports hôte (modifier si conflit avec apps existantes)
# Vérifier : ./deploy/check-ports.sh 8093 3313
SENTRAVAUX_HTTP_PORT=8093
SENTRAVAUX_MYSQL_PORT=3313
APP_VERSION=latest
INSTALL_OCI8=true

# Première mise en prod : migrations automatiques au démarrage
RUN_MIGRATIONS=false

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sentravaux
DB_USERNAME=sentravaux
DB_PASSWORD=CHANGER_MOT_DE_PASSE_DB

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=webmail.senelec.sn
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="nepasrepondre@senelec.sn"
MAIL_FROM_NAME="${APP_NAME}"

# LDAP (réseau interne - accessible depuis le conteneur)
LDAP_ENABLED=true
LDAP_LOGGING=false
LDAP_CONNECTION=default
LDAP_HOST=10.101.2.30
LDAP_USERNAME="CN=Service Appli ODM,CN=Users,DC=electricite,DC=sn"
LDAP_PASSWORD=
LDAP_PORT=3268
LDAP_BASE_DN="DC=electricite,DC=sn"
LDAP_TIMEOUT=5
LDAP_SSL=false
LDAP_TLS=false
LDAP_SASL=false

# Oracle RH (réseau interne)
ORACLE_HOST=10.101.3.119
ORACLE_PORT=1521
ORACLE_DATABASE=EXP11I
ORACLE_SERVICE_NAME=EXP11I
ORACLE_USERNAME=Apps
ORACLE_PASSWORD=
ORACLE_CHARSET=AL32UTF8
